# Alisio Podman environment
# Copy to alisio.podman.env.local and set ALISIO_GATEWAY_TOKEN (or use -e when running).
# This file can be used with:
#   ALISIO_PODMAN_ENV=/path/to/alisio.podman.env ./scripts/run-alisio-podman.sh launch

# Required: gateway auth token. Generate with: openssl rand -hex 32
# Set this before running the container (or use run-alisio-podman.sh which can generate it).
ALISIO_GATEWAY_TOKEN=

# Optional: web provider (leave empty to skip)
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=

# Host port mapping (defaults; override if needed)
ALISIO_PODMAN_GATEWAY_HOST_PORT=

# Gateway bind (used by the launch script)
ALISIO_GATEWAY_BIND=lan

# Optional: LLM provider API keys (for zero cost use Groq free tier)
# GROQ_API_KEY=
