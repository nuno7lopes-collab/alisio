# Copy the values you need into your shell or CI secrets before a signed/notarized build.
# This file is documentation only; the scripts read exported environment variables.

# Required for codesign.
SIGN_IDENTITY="Developer ID Application: <Legal Name> (<TEAMID>)"

# Preferred notary auth: keychain profile created with:
# xcrun notarytool store-credentials <profile-name> ...
NOTARYTOOL_PROFILE="<notarytool-profile>"

# Alternative notary auth via App Store Connect API key.
NOTARYTOOL_KEY="/absolute/path/AuthKey_<KEYID>.p8"
NOTARYTOOL_KEY_ID="<KEYID>"
NOTARYTOOL_ISSUER="<ISSUER-UUID>"

# Optional packaging overrides.
BUNDLE_ID="pt.ritaalves.alisio"
APP_BUILD="<build-number>"
CODESIGN_TIMESTAMP="auto"
SKIP_TEAM_ID_CHECK="0"
SKIP_NOTARIZE="0"
